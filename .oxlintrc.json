{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "node", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["build/**", "coverage/**"]
}
