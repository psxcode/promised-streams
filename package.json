{
  "name": "promised-streams-monorepo",
  "private": true,
  "homepage": "https://github.com/psxcode/promise-streams",
  "license": "MIT",
  "author": "psxcode <psxcode@gmail.com> (https://github.com/psxcode)",
  "workspaces": [
    "promised-streams",
    "promised-streams-test"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test \"promised-streams/test/*.spec.ts\" \"promised-streams-test/test/*.spec.ts\"",
    "test:watch": "node --test --watch \"promised-streams/test/*.spec.ts\" \"promised-streams-test/test/*.spec.ts\"",
    "test:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-coverage-include='**/src/**' \"promised-streams/test/*.spec.ts\" \"promised-streams-test/test/*.spec.ts\"",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "npm run build -w promised-streams && npm run build -w promised-streams-test",
    "clean": "node -e \"for (const d of ['promised-streams/build','promised-streams-test/build','coverage']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
